<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- 10.0.15 matches the .NET 10 LTS servicing line. MIT. Structured logging without a custom logger. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <!-- Apache-2.0. Unit tests for the portable foundation. -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- MIT. VSTest host for the unit tests. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- 10.0.15, MIT, net10.0. Explicit LDAP reads. Not System.DirectoryServices. -->
    <PackageVersion Include="System.DirectoryServices.Protocols" Version="10.0.15" />
    <!-- 4.92.0, MIT, net8.0 and netstandard2.0. Public client with the authorization code flow. No secret. -->
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.92.0" />
    <!-- 4.92.0, MIT, netstandard2.0. Windows broker (WAM) integration for the desktop interactive flow. -->
    <PackageVersion Include="Microsoft.Identity.Client.Broker" Version="4.92.0" />
    <!-- 6.10.0, MIT, net10.0. Typed read-only Microsoft Graph requests. Ships a net10.0 asset. -->
    <PackageVersion Include="Microsoft.Graph" Version="6.10.0" />
    <!-- 7.6.10, MIT, net10.0. Hosts the Exchange Online PowerShell module in-process. 7.7.0 is net11.0 only. -->
    <PackageVersion Include="Microsoft.PowerShell.SDK" Version="7.6.10" />
  </ItemGroup>
</Project>
