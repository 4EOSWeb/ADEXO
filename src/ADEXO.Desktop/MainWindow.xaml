<Window x:Class="ADEXO.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ADEXO.Desktop"
        Title="ADEXO" Height="820" Width="1120" MinHeight="620" MinWidth="900">

    <Window.Resources>
        <!-- Semantic severity colours. Kept few and quiet: this is an administration tool, not a dashboard. -->
        <SolidColorBrush x:Key="NormalBrush" Color="#1F1F1F" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6B6B6B" />
        <SolidColorBrush x:Key="GoodBrush" Color="#107C10" />
        <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
        <SolidColorBrush x:Key="CriticalBrush" Color="#A4262C" />
        <SolidColorBrush x:Key="RuleBrush" Color="#E1E1E1" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FAFAFA" />

        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource NormalBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,6" />
            <Setter Property="Foreground" Value="{StaticResource NormalBrush}" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Width" Value="190" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="90" />
        </Style>

        <!-- Converts a DetailSeverity to a brush, so the view model stays UI-free. -->
        <local:SeverityBrushConverter x:Key="SeverityBrush" />
        <local:BoolToVisibleConverter x:Key="BoolToVisible" />
        <local:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />

        <!-- Renders one DetailGroup as a titled block of label/value rows. -->
        <DataTemplate x:Key="DetailGroupTemplate">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                <Border Height="1" Background="{StaticResource RuleBrush}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource RowLabel}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding Value, Mode=OneWay}"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0"
                                         Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                         TextWrapping="Wrap"
                                         AutomationProperties.Name="{Binding Label}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Footnote}"
                           Foreground="{StaticResource WarningBrush}"
                           Margin="0,6,0,0"
                           FontSize="12"
                           Visibility="{Binding Footnote, Converter={StaticResource EmptyToCollapsed}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Renders one whole section: busy indicator, empty state, or groups. -->
        <DataTemplate x:Key="SectionTemplate">
            <Grid>
                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}">
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,4,0,12" />
                    <TextBlock Text="{Binding EmptyMessage}" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="{Binding EmptyMessage}"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,8,0,0" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Groups}"
                              ItemTemplate="{StaticResource DetailGroupTemplate}"
                              Visibility="{Binding HasContent, Converter={StaticResource BoolToVisible}}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="ADEXO" FontSize="26" FontWeight="Light" />
            <TextBlock Text="Read-only directory and cloud administration" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="{Binding Product.StatusLine}" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" />
            <TextBlock Text="{Binding Product.SectionMessage}" Foreground="{StaticResource WarningBrush}" Margin="0,2,0,0" />
            <Border Height="1" Background="{StaticResource RuleBrush}" Margin="0,12,0,0" />
        </StackPanel>

        <!-- Command bar -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Refresh AD" Command="{Binding RefreshCommand}" />
            <Button Content="Sign in to Microsoft 365" Command="{Binding Cloud.SignInCommand}" Click="SignInCloud" />
            <Button Content="Cancel sign-in" Command="{Binding Cloud.CancelCommand}" />
            <Button Content="Refresh Microsoft 365" Command="{Binding Cloud.RefreshCommand}" />
            <Button Content="Connect Exchange Online" Command="{Binding Product.ConnectExchangeCommand}" />
            <Button Content="Disconnect Exchange" Command="{Binding Product.DisconnectExchangeCommand}" />
            <Button Content="Refresh mailbox" Command="{Binding Product.RefreshAllCommand}" />
            <Button Content="Sign out" Command="{Binding Cloud.SignOutCommand}" />
            <Button Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}" Click="CopyDefault" />
            <Button Content="Close" Click="CloseClick" />
        </StackPanel>

        <!-- Provider status strip -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10,6" Background="#F2F2F2">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Exchange Online:" FontWeight="SemiBold" Margin="0,0,6,0" />
                <TextBlock Text="{Binding Product.ExchangeConnectionText}" />
                <TextBlock Text="{Binding Product.ExchangeOrganization}" Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0" />
                <TextBlock Text="{Binding Product.CorrelationState, StringFormat=      Cloud correlation: {0}}" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Border>

        <!-- Sections -->
        <TabControl Margin="0,12,0,0" Background="{StaticResource PanelBrush}">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <ContentControl Content="{Binding Product.Overview}" ContentTemplate="{StaticResource SectionTemplate}" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Active Directory">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <ContentControl Content="{Binding Product.ActiveDirectory}" ContentTemplate="{StaticResource SectionTemplate}" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Microsoft 365">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <ContentControl Content="{Binding Product.Microsoft365}" ContentTemplate="{StaticResource SectionTemplate}" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Mailbox">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <ContentControl Content="{Binding Product.Mailbox}" ContentTemplate="{StaticResource SectionTemplate}" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Email addresses">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <ContentControl Content="{Binding Product.EmailAddresses}" ContentTemplate="{StaticResource SectionTemplate}" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Delegation">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <ContentControl Content="{Binding Product.Delegation}" ContentTemplate="{StaticResource SectionTemplate}" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Diagnostics">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <ContentControl Content="{Binding Product.Diagnostics}" ContentTemplate="{StaticResource SectionTemplate}" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
